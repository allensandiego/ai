{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "qwen3.8-27b@iq3_xxs",
  "instructions": ["AGENTS.md"],
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/home/allen/m.2/**": "allow"
    },
    "edit": {
      "mvnw": "deny",
      "mvnw.cmd": "deny",
      "/home/allen/m.2/**": "deny",
      "pom.xml": "deny"
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://amd.lan:1234/v1"
      },
      "models": {
        "qwen3.8-27b@iq3_xxs": {
          "name": "Qwen3.8 27B",
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ]
          },
          "limit": {
            "context": 98304,
            "input": 65536,
            "output": 16384
          }
        }
      }
    }
  }
}
