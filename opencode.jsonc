{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/home/allen/.m2/**": "allow"
    },
    "edit": {
      "mvnw": "deny",
      "mvnw.cmd": "deny",
      "/home/allen/m.2/**": "deny",
      "pom.xml": "deny"
    }
  },
  "model": "lmstudio/qwen3.8-27b-gsq-rco@iq2_s",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://amd.lan:1234/v1"
      },
      "models": {
        "qwen3.5-9b-mtp@q6_k": {
          "name": "Qwen3.5 9B",
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ]
          },
          "limit": {
            "context": 131072,
            "input": 98304,
            "output": 16384
          }
        },
        "qwen3.5-4b-mtp@q8_0": {
          "name": "Qwen3.5 4B",
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ]
          },
          "limit": {
            "context": 262144,
            "input": 196608,
            "output": 65536
          }
        },
        "qwen3.8-27b-gsq-rco@iq2_s": {
          "name": "Qwen3.8 27B",
          "modalities": {
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ]
          },
          "limit": {
            "context": 131072,
            "input": 98304,
            "output": 32768
          },
          "capabilities": {
            "temperature": true,
            "reasoning": {
              "support": true,
              "toggle": true,
              "effort": [
                "low",
                "medium",
                "xhigh"
              ]
            }            
          }
        }
      }
    }
  }
}